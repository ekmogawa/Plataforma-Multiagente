{
  "$ref": "#/definitions/ExecutionResult",
  "definitions": {
    "ExecutionResult": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "timeout"
          ]
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "created",
                  "modified",
                  "deleted"
                ]
              }
            },
            "required": [
              "path",
              "action"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "logs": {
          "type": "string",
          "default": ""
        },
        "tokenUsage": {
          "type": "object",
          "properties": {
            "in": {
              "type": "integer",
              "minimum": 0
            },
            "out": {
              "type": "integer",
              "minimum": 0
            },
            "cacheRead": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          "required": [
            "in",
            "out"
          ],
          "additionalProperties": false
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "errorSummary": {
          "type": "string"
        }
      },
      "required": [
        "taskId",
        "attempt",
        "status",
        "durationMs"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
