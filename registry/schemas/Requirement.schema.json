{
  "$ref": "#/definitions/Requirement",
  "definitions": {
    "Requirement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "functional",
            "non-functional"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "must",
            "should",
            "could",
            "wont"
          ],
          "default": "should"
        },
        "source": {
          "type": "string",
          "default": "inferido"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Requirement/properties/id"
          },
          "default": []
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
