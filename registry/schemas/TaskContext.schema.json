{
  "$ref": "#/definitions/TaskContext",
  "definitions": {
    "TaskContext": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "full",
                  "summary"
                ]
              }
            },
            "required": [
              "path",
              "content",
              "mode"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "conventions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "priorDecisions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "priorFailure": {
          "type": "string"
        },
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "taskId",
        "estimatedTokens"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
