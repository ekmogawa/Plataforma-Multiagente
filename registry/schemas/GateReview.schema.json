{
  "$ref": "#/definitions/GateReview",
  "definitions": {
    "GateReview": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "enum": [
            "approve",
            "revise",
            "escalate"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "pattern",
                  "duplication",
                  "security",
                  "debt"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warn",
                  "high",
                  "critical"
                ]
              },
              "text": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            },
            "required": [
              "category",
              "severity",
              "text"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "runId",
        "verdict"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
