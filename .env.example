# Copie para .env e preencha. O .env fica fora do git (nunca comite chaves).

# ---- PRIMEIRA LINHA: NVIDIA (build.nvidia.com) ----
# Crie a chave em https://build.nvidia.com. A baseUrl já está fixa no models.yaml
# (https://integrate.api.nvidia.com/v1); só a chave é necessária aqui.
NVIDIA_API_KEY=
# Opcional: só preencha se quiser sobrescrever a baseUrl padrão da NVIDIA.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- FALLBACK ESTRATÉGICO: Zenmux / Kimi K3 ----
# Gateway compatível com a API OpenAI onde o Kimi K3 está disponível.
ZENMUX_API_KEY=
ZENMUX_BASE_URL=

# ---- Alternativas (opcionais) ----
# Gateway OmniRouter (DeepSeek, Qwen, GLM, Gemini) — usado só se roteado a ele.
OMNIROUTER_API_KEY=
OMNIROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Claude (via assinatura Claude Code / Agent SDK) — adaptador ainda não implementado.
ANTHROPIC_API_KEY=
